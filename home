<script>
  function toggleDropdown(trigger) {
    const dropdown = trigger.closest('.custom-dropdown');
    const options = dropdown.querySelector('.dropdown-options');
    const isHidden = options.style.display === 'none' || options.style.display === '';
    document.querySelectorAll('.custom-dropdown .dropdown-options').forEach(el => {
      el.style.display = 'none';
    });
    options.style.display = isHidden ? 'block' : 'none';
  }

  function selectOption(optionEl, value) {
    const dropdown = optionEl.closest('.custom-dropdown');
    const trigger = dropdown.querySelector('.dropdown-trigger');
    const valueSpan = trigger.querySelector('.dropdown-value');
    valueSpan.textContent = value;
    dropdown.querySelector('.dropdown-options').style.display = 'none';
  }

  document.addEventListener('click', function(e) {
    if (!e.target.closest('.custom-dropdown')) {
      document.querySelectorAll('.custom-dropdown .dropdown-options').forEach(el => {
        el.style.display = 'none';
      });
    }
  });
</script>

